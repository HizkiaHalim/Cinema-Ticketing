version: '3.8'

services:
  postgres:
    image: postgres:15
    environment:
      POSTGRES_DB: cinema_db
      POSTGRES_USER: 
      POSTGRES_PASSWORD: 
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    restart: unless-stopped

volumes:
  postgres_data: